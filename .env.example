# Copy to .env and fill in your credentials — never commit .env
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_SECRET=your_access_token_secret

# Groq API — powers AI-generated mention replies (optional; falls back to
# templates if unset). Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional overrides
HISTORY_FILE=data/history.json
OUTPUT_DIR=data
